# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/jobgraph

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (optional — omit to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# API docs (Scalar + OpenAPI). Disabled in production unless SWAGGER_ENABLED=true
SWAGGER_ENABLED=true
SWAGGER_SERVER_URL=http://localhost:4000

# Redis (BullMQ scraper queue + analytics cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password

# Scraper schedule
SCRAPE_CRON=0 */6 * * *
SCRAPE_MAX_PAGES=2
SCRAPE_ON_BOOT=true

# Billing (Zarinpal)
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_AMOUNT=990000
CORE_API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=JobGraph <alerts@jobgraph.dev>
