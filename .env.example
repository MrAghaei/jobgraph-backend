# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/jobgraph

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth (optional — omit to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# API docs (Scalar + OpenAPI). Disabled in production unless SWAGGER_ENABLED=true
SWAGGER_ENABLED=true
SWAGGER_SERVER_URL=http://localhost:4000

# Redis (BullMQ scraper queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password
